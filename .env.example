# Hemas FMCG Distribution Channel Dashboard — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string (or local MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hemas_da2?retryWrites=true&w=majority

# Server port (optional — defaults to 5000)
PORT=5000
